# Callisthenes unit — credentials + guardrail knobs.
# Copy to units/callisthenes/.env for local runs, or set these as Dokploy compose
# Environment values in production. Do NOT commit a filled-in .env.
#
# X_* variable names mirror upstream xdevplatform/xmcp (and services/x-mcp/.env.example)
# at the pinned commit. With the headless-oauth1.patch, the server signs every request
# as your user using the OAuth1 access token + secret below — no browser consent at boot.
#
# NB per-tenant PIN chat-auth (C-2, units/callisthenes/auth/) SUPERSEDES the single
# X_OAUTH_ACCESS_TOKEN below for the HOSTED multi-tenant path (each tenant connects via
# the "visit x.com, enter this PIN" OAuth 1.0a oob flow). The single-owner token here
# remains the DOGFOOD path and the fallback when the auth package is absent.

# --- Required: X app (consumer) credentials ---
X_OAUTH_CONSUMER_KEY=
X_OAUTH_CONSUMER_SECRET=
X_BEARER_TOKEN=

# --- Required for single-owner headless operation: OAuth1 user access token + secret ---
# X developer portal -> your app (Read+Write) -> "Keys and tokens" -> "Access Token and
# Secret". Or capture from a one-time interactive run with X_OAUTH_PRINT_TOKENS=1.
X_OAUTH_ACCESS_TOKEN=
X_OAUTH_ACCESS_TOKEN_SECRET=

# --- MCP transport (container) ---
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- Tool allowlist (read + post on ONE endpoint; send gate is in-unit middleware) ---
X_API_TOOL_ALLOWLIST=getPostsById,getPostsByIds,searchPostsRecent,getUsersPosts,getUsersById,getUsersByUsername,getUsersMe,getUsersMentions,createPosts,deletePosts,mediaUpload

# --- Callisthenes guardrails (default ON) ---
# Conservative hourly send cap. 0 = fully closed (block all sends); unset/negative => 10.
CALLISTHENES_THROTTLE_PER_HOUR=10
# Tools treated as "sends" for throttle + draft-guard.
CALLISTHENES_SEND_TOOLS=createPosts,deletePosts,mediaUpload
CALLISTHENES_GUARDED_TOOLS=createPosts,deletePosts,mediaUpload
# The approval arg a send must carry (drafts never send).
CALLISTHENES_APPROVE_ARG=callisthenes_approve
# Optional shared approve token: if set, the approval arg must EQUAL this exactly.
# Leave empty for truthy-flag approval mode.
CALLISTHENES_APPROVE_TOKEN=
