# X (Twitter) MCP — credentials for headless operation.
# Copy to services/x-mcp/.env for local runs, or set these as Dokploy app secrets
# in production. Do NOT commit a filled-in .env.
#
# Variable names mirror upstream xdevplatform/xmcp (env.example) at the pinned
# commit. With our headless-oauth1.patch, the server signs every request as your
# user using the OAuth1 access token + secret below — no browser consent at startup.

# --- Required: X app (consumer) credentials ---
X_OAUTH_CONSUMER_KEY=
X_OAUTH_CONSUMER_SECRET=
X_BEARER_TOKEN=

# --- Required for headless operation: OAuth1 user access token + secret ---
# Get these once from the X developer portal: your app -> "Keys and tokens" ->
# "Access Token and Secret" (the app must have Read+Write permissions if you want
# posting to work). Alternatively, capture them from a one-time local interactive
# run started with X_OAUTH_PRINT_TOKENS=1.
X_OAUTH_ACCESS_TOKEN=
X_OAUTH_ACCESS_TOKEN_SECRET=

# --- MCP transport (container) ---
# 0.0.0.0 so the endpoint is reachable from the runner over the shared network.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- Tool gating (the security control) ---
# Comma-separated OpenAPI operationIds. Set this PER INSTANCE in the compose file,
# not here — the read-only and post+read instances differ ONLY by this value.
# Confirm the exact ids against the server's "Loaded N tools" startup log.
X_API_TOOL_ALLOWLIST=

# Optional belt-and-braces: deny specific operationIds even if otherwise allowed.
# X_API_TOOL_DENYLIST=
