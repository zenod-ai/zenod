# Dedicated Codex fan-out runner.
#
# This image is intentionally separate from the Zenod app container: Zenod owns
# memory/ingest/MCP, while this runner owns repo worktrees, Codex workers, and
# GitHub PR/comment side effects.
FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.137.0
ARG CLAUDE_CODE_VERSION=latest

ENV NODE_ENV=production \
    HOME=/runner \
    CODEX_HOME=/runner/codex-home \
    CLAUDE_CONFIG_DIR=/runner/claude-home \
    GH_CONFIG_DIR=/runner/gh \
    FANOUT_WORKDIR=/runner/work \
    NPM_CONFIG_UPDATE_NOTIFIER=false

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      gawk \
      gh \
      git \
      jq \
      openssh-client \
      procps \
      ripgrep \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /runner/work /runner/codex-home /runner/claude-home /runner/gh /opt/zenod/scripts

# Two interchangeable worker CLIs: Codex (OpenAI) and Claude Code (Anthropic). The
# fan-out flow is engine-agnostic; default engine is claude (ZENOD_WORKER_ENGINE).
# Claude auth mirrors codex: either a long-lived subscription token in
# CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`), or OAuth creds from a one-time
# `claude` login persisted in the mounted CLAUDE_CONFIG_DIR (/runner/claude-home).
# Do NOT set ANTHROPIC_API_KEY when using subscription auth — it overrides OAuth.
RUN npm install -g "@openai/codex@${CODEX_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && codex --version \
 && claude --version

COPY scripts/fanout-codex.mjs /opt/zenod/scripts/fanout-codex.mjs
RUN chmod +x /opt/zenod/scripts/fanout-codex.mjs \
 && ln -s /opt/zenod/scripts/fanout-codex.mjs /usr/local/bin/zenod-fanout-codex

# Bake the backlog monitor into the IMAGE so a push to main actually redeploys
# its code. The supervisor runs THIS copy (not the /runner/work/zenod volume
# checkout, which an image rebuild never touches) — otherwise monitor changes
# silently never ship even though the runner "redeployed". The monitor still
# uses ZENOD_WORKDIR (the volume checkout) for git worktrees/fanout.
COPY scripts/backlog-monitor.mjs /opt/zenod/scripts/backlog-monitor.mjs

# Shared runner libs the monitor imports (I8-2 durable executor: ./lib/durable.mjs,
# budget.mjs, receipt.mjs). MUST be copied or backlog-monitor.mjs crashes on startup
# with "Cannot find module ./lib/durable.mjs" → supervisor crash-loop → dead runner
# (this is what took notifications dark after #509). Copy the whole dir so future
# lib additions ship automatically. Excludes *.test.mjs at runtime (harmless).
COPY scripts/lib/ /opt/zenod/scripts/lib/

# Idempotently provisions the X MCP client config (Codex read-only, Claude
# post+read) into the CODEX_HOME/HOME volumes on every start, then execs the CMD.
COPY scripts/agent-runner-entrypoint.sh /opt/zenod/scripts/agent-runner-entrypoint.sh
RUN chmod +x /opt/zenod/scripts/agent-runner-entrypoint.sh

# Route git's HTTPS credentials through gh, baked into the IMAGE (--system =
# /etc/gitconfig) so it survives container recreation. HOME=/runner is NOT a
# volume, so `gh auth setup-git` (which writes ~/.gitconfig) is lost on every
# recreate — which silently breaks `git push` for workers while gh-API calls
# keep working (they read the /runner/gh volume). The helper itself needs no
# token at build time; gh reads the token from /runner/gh at push time.
RUN git config --system credential."https://github.com".helper "!gh auth git-credential" \
 && git config --system credential."https://gist.github.com".helper "!gh auth git-credential"

WORKDIR /runner/work

VOLUME ["/runner/work", "/runner/codex-home", "/runner/claude-home", "/runner/gh"]

ENTRYPOINT ["/opt/zenod/scripts/agent-runner-entrypoint.sh"]
CMD ["bash", "-lc", "echo 'zenod-agent-runner ready'; sleep infinity"]
