# Per-tenant env for docker-compose.tenant.yml (P0.3, epic #448).
# Copy to a tenant-specific .env (or paste into Dokploy's env box) and fill in.

# Registry image the whole stack runs. Default :latest = what the fleet rolls to;
# pin an immutable build for rollback, e.g. sha-abc1234.
ZENOD_IMAGE_TAG=latest

# Cosmetic tenant label (used in docs/ops only; service DNS is namespaced by the
# Dokploy compose project name, not this).
TENANT_NAME=acme

# Phylax delivery bridge — the CONSOLE's own api_token (not Phylax's). Leave blank
# on first boot; fill after the Console mints its token (T8/#456 automates it).
PHYLAX_CONSOLE_TOKEN=

# --- Metering gateway (wired in P0.4/#452) -----------------------------------
# Once the LLM gateway is up, set these on the Console (and they propagate to the
# agents at provision time) so every token is metered + budget-capped per tenant.
# LLM_BASE_URL=https://gateway.zenod.dev/v1
# LLM_API_KEY=<per-tenant virtual key minted on the gateway>
