[Unit]
Description=zenod-watchdog — host-level self-outage reporter, alerts via the HQ queue (Epic-1 C-24, EPIC-6 S5)
# Runs even when Docker is down (that is the whole point) — no docker dependency.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/share/zenod-watchdog/zenod-watchdog.sh
# Never let a watchdog failure cascade; it logs to the user journal.
Nice=10
TimeoutStartSec=110
